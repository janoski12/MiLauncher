<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- ===== Fila superior: reloj/velocidad + música ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Reloj y fecha arriba, velocímetro circular grande abajo -->
        <LinearLayout
            android:id="@+id/infoCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pearl"
                    android:textSize="60sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/accent_line" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Diamantes de Mitsubishi + nombre del auto -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="7dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_diamantes" />

                        <TextView
                            android:id="@+id/carName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.25"
                            android:maxLines="1"
                            android:text="@string/car_name"
                            android:textColor="@color/silver"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="EEE d MMM"
                        android:format24Hour="EEE d MMM"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/gpsStatus"
                        style="@style/Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/gps_searching"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <cl.alejandro.milauncher.SpeedGaugeView
                android:id="@+id/gauge"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <Space
            android:layout_width="14dp"
            android:layout_height="match_parent" />

        <!-- Música (con la silueta del Lancer de fondo, abajo a la derecha) -->
        <FrameLayout
            android:id="@+id/musicCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true">

        <ImageView
            android:layout_width="260dp"
            android:layout_height="91dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:alpha="0.22"
            android:contentDescription="@null"
            android:scaleType="fitEnd"
            android:src="@drawable/lancer_silueta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:id="@+id/albumArt"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:background="@drawable/bg_art"
                android:contentDescription="@null"
                android:padding="36dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_music" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicApp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/musicTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/music_nothing"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/musicArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_round"
                        android:contentDescription="Anterior"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_prev" />

                    <ImageButton
                        android:id="@+id/btnPlay"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_play"
                        android:contentDescription="Reproducir o pausar"
                        android:padding="18dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play" />

                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_round"
                        android:contentDescription="Siguiente"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_next" />
                </LinearLayout>

                <TextView
                    android:id="@+id/musicHint"
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ===== Fila inferior: accesos rápidos (se llenan desde el código) ===== -->
    <LinearLayout
        android:id="@+id/slots"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal" />
</LinearLayout>
